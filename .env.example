# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_password_change_me
POSTGRES_DB=agentic
DATABASE_URL=postgresql+psycopg://agentic:agentic_password_change_me@postgres:5432/agentic

# Google Places
GOOGLE_PLACES_API_KEY=

# Codex / ChatGPT account auth
# Do not put ChatGPT or Codex tokens in .env.
# Run `codex login --device-auth` on the Pi and keep credentials in ~/.codex/auth.json.
CODEX_ENABLED=true
CODEX_WORKDIR=/app/.generated-sites
CODEX_DEFAULT_MODEL=
CODEX_TIMEOUT_SECONDS=900

# SMTP email sending from the Raspberry Pi.
# For local Postfix relay on the Pi, use host.docker.internal:25 with no username/password.
# For external SMTP providers, use their host/port/auth settings.
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Denny
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_REPLY_TO=

# GitHub automation
GITHUB_TOKEN=
GITHUB_OWNER=Ethan0908
# Optional. Leave empty to create generated repos directly instead of from a template repo.
GITHUB_TEMPLATE_REPO=
GITHUB_GENERATED_REPO_PRIVATE=true
# Optional central archive folder for all generated business websites.
GITHUB_ARCHIVE_REPO=Agentic
GITHUB_ARCHIVE_BRANCH=starter-postgres-website-maker
GITHUB_ARCHIVE_PATH=business-websites

# Vercel automation
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional public base URL for dashboard/API
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Outreach safety
DEFAULT_NO_RESPONSE_DAYS=30
ALLOW_AUTO_SEND_EMAILS=false
ALLOW_AUTO_DELETE_DEPLOYMENTS=false
