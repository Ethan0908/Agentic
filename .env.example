# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_password_change_me
POSTGRES_DB=agentic
DATABASE_URL=postgresql+psycopg://agentic:agentic_password_change_me@postgres:5432/agentic

# Google Places
GOOGLE_PLACES_API_KEY=

# Optional GPT email generation through the OpenAI API.
# Leave empty to use the built-in deterministic email template.
OPENAI_API_KEY=
OPENAI_EMAIL_MODEL=gpt-5.5

# SMTP email sending from the Raspberry Pi.
# Example Gmail SMTP host: smtp.gmail.com, port 587, TLS true, username your email,
# password an app password. A transactional provider is better for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Denny
SMTP_USE_TLS=true
SMTP_REPLY_TO=

# GitHub automation
GITHUB_TOKEN=
GITHUB_OWNER=Ethan0908
GITHUB_TEMPLATE_REPO=business-site-template

# Vercel automation
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional public base URL for dashboard/API
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Outreach safety
DEFAULT_NO_RESPONSE_DAYS=30
ALLOW_AUTO_SEND_EMAILS=false
ALLOW_AUTO_DELETE_DEPLOYMENTS=false
